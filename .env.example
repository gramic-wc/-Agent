# 复制为 .env 后填写。不要提交到 git。
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxx

# 通义千问（兼容 OpenAI 协议）
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_NATIVE_BASE=https://dashscope.aliyuncs.com/api/v1

# 模型：文本 / 视觉 / 向量 / 重排
LLM_MODEL=qwen-plus
VLM_MODEL=qwen-vl-max-latest
EMBED_MODEL=text-embedding-v3
EMBED_DIM=1024
EMBED_BATCH=10
RERANK_MODEL=gte-rerank-v2
RERANK_ENABLED=1

# 向量库：留空=嵌入式本地模式（data/qdrant）；填 http://localhost:6333=服务端
QDRANT_URL=
COLLECTION=eq_chunks
